# MySQL / MariaDB backup configuration (Local instance)
# Filename pattern must match: backup_mysql_*.conf

DB_HOST="localhost"
AUTH_FILE="${CONF_PATH}/auth_mysql.conf"
AUTH_USERNAME="backup"
AUTH_PASSWORD=""

# Optional: extra options for mysqldump
DUMP_OPTS="-Q --skip-lock-tables --single-transaction"

# Databases to ignore when discovering automatically
IGNORED_DBS="information_schema performance_schema mysql sys"

# Optional: explicitly specify databases to back up separated by space.
# Leave empty to automatically discover all accessible databases.
DBS=""
