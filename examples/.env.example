# SimpleLinuxBackup environment configuration
# Place this file as .env in the script directory or /etc/backup/.env

CONF_PATH="/etc/backup"
DEST="/var/backups"
OWNER="root"
GROUP="root"

# Email reporting
SEND_EMAIL=0
NOTIFY_EMAIL="root@localhost"
NOTIFY_SUBJECT="Backup Notification"

# Retention
DELETE_OLD_BACKUPS=1
DELETE_BACKUPS_OLDER_THAN_DAYS=5

# Optional cloud upload via rclone
# CLOUD_TARGET="remote:bucket/path"
